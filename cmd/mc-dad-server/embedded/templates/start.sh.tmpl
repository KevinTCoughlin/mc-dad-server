#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

MEMORY="${MC_MEMORY:-{{.Memory}}}"
GC_TYPE="${MC_GC_TYPE:-{{.GCType}}}"

# Detect Java
if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
else
    JAVA_CMD="java"
fi

# Build JVM flags
JVM_FLAGS=(
    -Xms"$MEMORY"
    -Xmx"$MEMORY"
)

if [[ "${GC_TYPE,,}" == "zgc" ]]; then
    # Generational ZGC is the only ZGC mode on Java 25. The ZGenerational
    # flag was removed in JDK 24 and must not be passed.
    JVM_FLAGS+=(
        -XX:+UseZGC
        -XX:+AlwaysPreTouch
        -XX:+DisableExplicitGC
        -XX:+PerfDisableSharedMem
        -XX:+ExitOnOutOfMemoryError
    )
else
    # G1 tuned for Java 25. These are Aikar's flags, which JDK 25 still
    # accepts (https://docs.papermc.io/paper/aikars-flags). ExitOnOutOfMemoryError
    # stops a wedged process so the service manager can restart it.
    JVM_FLAGS+=(
        -XX:+UseG1GC
        -XX:+ParallelRefProcEnabled
        -XX:MaxGCPauseMillis=200
        -XX:+UnlockExperimentalVMOptions
        -XX:+DisableExplicitGC
        -XX:+AlwaysPreTouch
        -XX:G1NewSizePercent=30
        -XX:G1MaxNewSizePercent=40
        -XX:G1HeapRegionSize=8M
        -XX:G1ReservePercent=20
        -XX:G1HeapWastePercent=5
        -XX:G1MixedGCCountTarget=4
        -XX:InitiatingHeapOccupancyPercent=15
        -XX:G1MixedGCLiveThresholdPercent=90
        -XX:G1RSetUpdatingPauseTimePercent=5
        -XX:SurvivorRatio=32
        -XX:+PerfDisableSharedMem
        -XX:MaxTenuringThreshold=1
        -XX:+ExitOnOutOfMemoryError
        -Dusing.aikars.flags=https://mcflags.emc.gs
        -Daikars.new.flags=true
    )
fi

echo "Starting Minecraft server with ${MEMORY} RAM (${GC_TYPE^^} GC)..."
exec "$JAVA_CMD" "${JVM_FLAGS[@]}" -jar server.jar nogui
