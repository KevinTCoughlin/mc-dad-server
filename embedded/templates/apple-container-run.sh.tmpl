#!/bin/bash
# MC Dad Server — Apple container run script (macOS)
# Generated by: mc-dad-server setup-container
# Run by launchd agent {{.Label}}; it plays the role the Podman Quadlet unit
# plays on Linux. Apple's `container` has no restart policy or healthcheck, so
# launchd restarts this script when the server exits with an error.
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
NAME="minecraft"
IMAGE="{{.Image}}"

if ! container system status >/dev/null 2>&1; then
  container system start
fi

# Podman and Docker seed a new named volume from the image (content and
# ownership); Apple's `container` creates it empty and root-owned. Seed each
# volume once, when it is created, so the image's plugins are present and the
# non-root server user (uid 1000) can write to it.
for v in worlds plugins logs backups; do
  if ! container volume inspect "minecraft-${v}" >/dev/null 2>&1; then
    container volume create "minecraft-${v}" >/dev/null
    container run --rm --progress none --user 0 --entrypoint /bin/sh -v "minecraft-${v}:/seed" "${IMAGE}" \
      -c "if [ -d /minecraft/${v} ]; then cp -a /minecraft/${v}/. /seed/; fi; chown 1000:1000 /seed" >/dev/null
  fi
done

# Replace any previous container so config changes take effect. The container
# is kept (no --rm) after it stops so `mc-dad-server start` can restart it.
container rm -f "${NAME}" >/dev/null 2>&1 || true

# Server settings are passed as env vars that entrypoint.sh substitutes into
# the image's server.properties. Config files are deliberately not
# bind-mounted: Paper rewrites them at startup via atomic rename, which fails
# on a single-file bind mount ("Resource busy") and aborts the server.
exec container run --progress none --name "${NAME}" \
  -p {{.Port}}:{{.Port}}/tcp \
  -p {{.BedrockPort}}:{{.BedrockPort}}/udp \
  -p 127.0.0.1:25575:25575/tcp \
  -v minecraft-worlds:/minecraft/worlds \
  -v minecraft-plugins:/minecraft/plugins \
  -v minecraft-logs:/minecraft/logs \
  -v minecraft-backups:/minecraft/backups \
  --env-file {{sq .EnvFile}} \
  -e MEMORY={{sq .Memory}} \
  -e GC_TYPE={{sq .GCType}} \
  -e PORT={{.Port}} \
  -e RCON_PORT=25575 \
  -e DIFFICULTY={{sq .Difficulty}} \
  -e GAMEMODE={{sq .GameMode}} \
  -e MAX_PLAYERS={{.MaxPlayers}} \
  -e MOTD={{sq .MOTD}} \
  -e WHITELIST={{.Whitelist}} \
  --cap-drop ALL \
  -m {{.MemoryMax}} \
  -c 2 \
  "${IMAGE}"
